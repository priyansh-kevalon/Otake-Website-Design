# Copy this file to .env and fill in the values for your machine.
# Only variables prefixed with VITE_ are exposed to the client code.

# App metadata
VITE_APP_NAME=Otake
VITE_APP_TAGLINE=Design, build and ship with Otake

# Dev server
VITE_DEV_PORT=5174

# Backend API
VITE_API_BASE_URL=http://localhost:8000/api

# Auth providers
VITE_GOOGLE_CLIENT_ID=
VITE_TWITTER_CLIENT_ID=

# Contact details shown on the Contact page
VITE_SUPPORT_EMAIL=contact@otake.com
VITE_SUPPORT_PHONE=+1 (555) 000-1234
